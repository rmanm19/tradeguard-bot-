# ۱. توکن رباتی که از @BotFather در تلگرام می‌گیرید
BOT_TOKEN=123456789:ABCDEF_your_telegram_bot_token_here

# ۲. آدرس فرانت‌اند مینی‌اپ (بعد از آپلود رایگان روی Cloudflare Pages یا سرور)
MINI_APP_URL=https://your-tradeguard-app.pages.dev

# ۳. قیمت اشتراک ماهانه به استارز تلگرام (۳۰۰ استارز ≈ ۴ دلار)
SUBSCRIPTION_STARS=300

# ۴. آیدی کانال ویترین عمومی برای پست‌گذاری خودکار هر ۸ ساعت (اختیاری - ربات باید ادمین کانال باشد)
PUBLIC_CHANNEL_ID=

# ۵. تعداد دعوت مورد نیاز برای باز شدن ۷ روز اشتراک پرو رایگان (موتور رشد ویروسی)
FREE_PRO_INVITE_TARGET=3

# ۶. آیدی عددی تلگرام خودتان (مؤسس) برای دسترسی به پنل مدیریت /admin و ارسال همگانی /broadcast
ADMIN_USER_ID=

# ۷. تنظیمات AI Agent داخلی ربات (اختیاری - قابل اتصال رایگان به Groq یا OpenRouter)
AI_API_BASE=https://openrouter.ai/api/v1
AI_API_KEY=sk-or-v1-your_key_here
AI_MODEL=google/gemini-2.5-flash
